FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app \
    && mkdir -p /app/.streamlit \
    && chown -R app:app /app /home/app

COPY requirements-dashboard.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
RUN set -eu; \
    for spec in 'msgpack>=1.2.3' 'setuptools>=78.1.1' 'urllib3>=2.8.0'; do \
      package="${spec%%[<>=]*}"; \
      if python -c 'import importlib.metadata, sys; importlib.metadata.distribution(sys.argv[1])' "$package" >/dev/null 2>&1; then \
        python -m pip install --no-cache-dir --upgrade "$spec"; \
      else \
        echo "Skipping $package: not installed in the dashboard dependency set."; \
      fi; \
    done; \
    python -m pip check; \
    python -m pip show msgpack setuptools urllib3 || true

COPY --chown=app:app application/ ./application/
COPY --chown=app:app core/ ./core/
COPY --chown=app:app .streamlit/config.toml ./.streamlit/config.toml

USER 10001:10001

EXPOSE 8501

CMD ["streamlit", "run", "application/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]

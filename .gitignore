.venv/
**/.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
.pytest_cache/
.coverage
htmlcov/

# Local secrets and credentials
.streamlit/secrets.toml
**/secrets.toml
.aws/
**/.aws/
.ssh/
**/.ssh/
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
credentials
**/credentials
credentials.*

# Runtime databases and SQLite sidecars; retain only the data directory marker
*.db
*.db-*
*.sqlite
*.sqlite3
data/*
!data/.gitkeep

# Ephemeral test and local runtime artifacts
archive/backups/
archive/test-artifacts/
tmp*/
**/tmp*/
*-tests-*/
**/*-tests-*/
*.log
.streamlit/cache/

# Generated experiment output (retain local results, do not stage by default)
/experiments/results/

# Terraform local data and generated plans; keep .terraform.lock.hcl trackable
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
!*.tfvars.example
**/backend.hcl

# Local Kubernetes credentials
.kube/
**/.kube/
kubeconfig
kubeconfig.*
*.kubeconfig

# Local Docker credentials
.docker/
**/.docker/
*.dockerconfigjson

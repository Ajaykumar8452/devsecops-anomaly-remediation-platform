aws_region          = "ap-south-1"
project             = "devsecops-anomaly-remediation-platform"
environment         = "dev"
vpc_cidr            = "10.40.0.0/16"
public_subnet_cidr  = "10.40.1.0/24"
availability_zone   = "ap-south-1a"

# Optional: set a reviewed Ubuntu 24.04 AMD64 AMI ID to pin the image.
# Leave unset to query Canonical's Ubuntu 24.04 AMD64 images through EC2.
# ami_id = "ami-0123456789abcdef0"

instance_type         = "m7i-flex.large"
jenkins_instance_type = "m7i-flex.large"
jenkins_root_volume_size_gib = 50
k3s_version          = "v1.36.6+k3s1"
root_volume_size_gib = 30

# The existing AWS EC2 key pair kp251026 must already exist in ap-south-1.
# Terraform references it by name; it does not create or import a key pair.
admin_cidr = "REPLACE_WITH_YOUR_PUBLIC_IPV4/32"

# Local development: Streamlit uses this URL to reach FastAPI.
# Docker Compose overrides it with http://backend:8000 inside the dashboard container.
ANOMALY_DASHBOARD_API_URL=http://127.0.0.1:8000

# Browser-facing Grafana URL used by Streamlit dashboard links.
# Compose defaults to localhost; override this when browsers use another host.
GRAFANA_BASE_URL=http://127.0.0.1:3000
# Optional direct starting link for the general Grafana button; defaults to GRAFANA_BASE_URL.
# GRAFANA_DASHBOARD_URL=http://127.0.0.1:3000/d/<dashboard-id>

# For Compose, separately copy monitoring/grafana/grafana.env.example to the
# ignored repository-root .env.grafana file and replace its placeholder password.
# Never commit .env, .env.grafana, or actual credentials.

# The backend defaults to <project-root>/data/alerts.db.
# ALERT_DATABASE_PATH may be set in the process environment when a different
# database is intentionally required. Do not commit database files.
